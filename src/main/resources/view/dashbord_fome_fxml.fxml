<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashbordFomeFxml">

    <children>
        <!-- Sidebar -->
        <VBox layoutX="0" layoutY="0" prefHeight="400.0" prefWidth="160.0" spacing="15" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="☰  Dashboard" />

                <Button fx:id="btnHome" onAction="#homeAction" prefWidth="140" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" text="🏠 Home" />
                <Button fx:id="btnProfile" onAction="#actionProfile" prefWidth="140" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" text="👤 Profile" />
                <Button fx:id="btnSettings" onAction="#actionSettings" prefWidth="140" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" text="⚙ Settings" />
                <Button prefWidth="140" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8;" text="🚪 Logout" />
            </children>
        </VBox>

        <!-- Top Bar -->
        <HBox layoutX="160" layoutY="0" prefHeight="50.0" prefWidth="440.0" style="-fx-background-color: #3498db; -fx-alignment: center-left; -fx-padding: 10;">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="Welcome to Dashboard" />
                <Region HBox.hgrow="ALWAYS" />
                <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px;" text="🔔" />
                <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" text="👤 Admin" />
            </children>
        </HBox>

        <!-- Content Area -->
        <AnchorPane layoutX="160" layoutY="50" prefHeight="350.0" prefWidth="440.0" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 1; -fx-padding: 20;">
            <children>
                <Label layoutX="150" layoutY="40" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="👋 Hello, Admin!" />

                <Label layoutX="50" layoutY="100" prefWidth="340" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" text="This is your main dashboard area. You can place charts, tables, or other components here." wrapText="true" />

                <Button fx:id="btnAddNew" layoutX="160" layoutY="200" onAction="#actionAddNew" prefWidth="120" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 14px;" text="➕ Add New" />
            </children>
        </AnchorPane>

    </children>
</AnchorPane>
