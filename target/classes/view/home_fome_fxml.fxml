<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="700.0" style="-fx-background-color: linear-gradient(to bottom right, #1e3c72, #2a5298);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.HomeController">



    <children>

        <!-- Top Header -->

        <HBox prefHeight="60.0" prefWidth="700.0" style="-fx-background-color: #0d1b2a; -fx-padding: 10; -fx-alignment: center-left;">

            <children>

                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" text="🏠 Home" />

                <Region HBox.hgrow="ALWAYS" />

                <Button style="-fx-background-color: #1e3c72; -fx-text-fill: white; -fx-background-radius: 8;" text="Profile" />

                <Button style="-fx-background-color: #ff4b2b; -fx-text-fill: white; -fx-background-radius: 8; -fx-margin-left: 10;" text="Logout" />

            </children>

        </HBox>



        <!-- Main Content -->

        <VBox alignment="CENTER" layoutX="100" layoutY="100" prefHeight="250" prefWidth="500" spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 12,0,0,8);">



            <children>

                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e3c72;" text="Welcome to Home Page 🎉" />



                <Label style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Select an option below to continue:" />



                <HBox alignment="CENTER" spacing="20">

                    <children>

                        <Button fx:id="btnTableView" onAction="#actionTableView" style="-fx-background-color: #1e3c72; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20;" text="Table View" />

                        <Button style="-fx-background-color: #2a5298; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20;" text="Settings" />

                        <Button style="-fx-background-color: #4e73df; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20;" text="Help" />

                    </children>

                </HBox>

            </children>

        </VBox>

    </children>

</AnchorPane>
