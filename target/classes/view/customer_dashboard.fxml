<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.CustomorDashboadController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to right, #74ebd5, #ACB6E5);">

    <children>

        <!-- Top Bar -->
        <HBox prefHeight="60.0" prefWidth="600.0"
              style="-fx-background-color: rgba(255,255,255,0.8); -fx-padding: 10; -fx-alignment: CENTER_LEFT;">
            <Label text="Customer Dashboard" style="-fx-text-fill: #333;">
                <font>
                    <Font size="22.0" />
                </font>
            </Label>
        </HBox>

        <!-- Main Content -->
        <VBox layoutX="150.0" layoutY="100.0" spacing="20" alignment="CENTER"
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);"
              prefWidth="300.0">

            <Label text="Welcome!" style="-fx-text-fill: #333;">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>

            <Button text="Manage Customers" prefWidth="200"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10;" />

            <Button text="Manage Orders" prefWidth="200"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10;" />

            <Button text="Reports" prefWidth="200"
                    style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10;" />

        </VBox>
    </children>
</AnchorPane>
