<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #dfe9f3);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginFormController">

    <children>
        <!-- Title -->
        <Label layoutX="230" layoutY="50" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Login Form" />

        <!-- Username Label -->
        <Label layoutX="150" layoutY="150" style="-fx-font-size: 14px; -fx-text-fill: #34495e;" text="Username:" />

        <!-- Username Field -->
        <TextField fx:id="txtUsername" layoutX="250" layoutY="145" prefWidth="200" promptText="Enter Username" />

        <!-- Password Label -->
        <Label layoutX="150" layoutY="200" style="-fx-font-size: 14px; -fx-text-fill: #34495e;" text="Password:" />

        <!-- Password Field -->
        <PasswordField fx:id="txtPassword" layoutX="250" layoutY="195" prefWidth="200" promptText="Enter Password" />

        <!-- Login Button -->
        <Button fx:id="btnLogin" layoutX="250" layoutY="260" onAction="#btnLoginonAction" prefWidth="200" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8;" text="Login" />

    </children>
</AnchorPane>
