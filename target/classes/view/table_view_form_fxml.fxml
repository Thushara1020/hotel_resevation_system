<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="665.0" prefWidth="982.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TableinfoController">

    <children>
      <Label layoutX="374.0" layoutY="14.0" prefHeight="57.0" prefWidth="235.0" text="Room Table">
         <font>
            <Font size="46.0" />
         </font>
      </Label>
      <TableView fx:id="tableView" layoutX="51.0" layoutY="262.0" prefHeight="389.0" prefWidth="880.0">
        <columns>
          <TableColumn fx:id="colRoomID" prefWidth="220.0" text="RoomID" />
          <TableColumn fx:id="colType" minWidth="0.0" prefWidth="186.0" text="Type" />
            <TableColumn fx:id="colDescription" minWidth="0.0" prefWidth="255.0" text="Description" />
            <TableColumn fx:id="colPrice" prefWidth="218.0" text="Price" />
        </columns>
      </TableView>
      <TextField fx:id="txtRoomID" layoutX="290.0" layoutY="95.0" />
      <TextField fx:id="txtTypr" layoutX="533.0" layoutY="95.0" />
      <TextField fx:id="txtDescription" layoutX="290.0" layoutY="140.0" />
      <TextField fx:id="txtPrice" layoutX="533.0" layoutY="140.0" />
      <Button fx:id="btnAdd" layoutX="307.0" layoutY="210.0" mnemonicParsing="false" onAction="#addAction" text="Add" />
      <Button fx:id="btnUpDate" layoutX="423.0" layoutY="211.0" mnemonicParsing="false" onAction="#updateAction" text="UpDate" />
      <Button fx:id="btnDelet" layoutX="527.0" layoutY="212.0" mnemonicParsing="false" onAction="#deletAction" text="Delet" />
      <Button fx:id="btnClear" layoutX="630.0" layoutY="211.0" mnemonicParsing="false" onAction="#clearAction" text="Clear" />
    </children>
</AnchorPane>
